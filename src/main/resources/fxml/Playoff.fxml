<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sportsmanager.ui.controller.PlayoffController"
            prefWidth="900" prefHeight="640"
            style="-fx-background-color: #0d0d1a;">

    <stylesheets>
        <URL value="@../css/theme.css"/>
    </stylesheets>

    <!-- ═══ TOP: Title ═══ -->
    <top>
        <VBox alignment="CENTER" spacing="6"
              style="-fx-padding: 32 0 24 0;">
            <Label text="PLAYOFF"
                   style="-fx-text-fill: #ffffff;
                          -fx-font-family: 'Impact';
                          -fx-font-size: 52px;
                          -fx-effect: dropshadow(gaussian, #e94560, 32, 0.4, 0, 0);"/>
            <Label fx:id="roundLabel" text=""
                   style="-fx-text-fill: #e94560;
                          -fx-font-family: 'Courier New';
                          -fx-font-size: 13px;
                          -fx-font-weight: bold;
                          -fx-letter-spacing: 3;"/>
            <HBox alignment="CENTER" spacing="0">
                <Region prefHeight="1" prefWidth="120"
                        style="-fx-background-color: #e94560; -fx-opacity: 0.3;"/>
                <Label text="  ─ ● ─  "
                       style="-fx-text-fill: #e94560;
                              -fx-font-family: 'Courier New';
                              -fx-font-size: 9px;
                              -fx-opacity: 0.5;"/>
                <Region prefHeight="1" prefWidth="120"
                        style="-fx-background-color: #e94560; -fx-opacity: 0.3;"/>
            </HBox>
        </VBox>
    </top>

    <!-- ═══ CENTER: Matchups ═══ -->
    <center>
        <VBox alignment="CENTER" spacing="12"
              style="-fx-padding: 0 80 0 80;">
            <Label text="EŞLEŞMELER"
                   style="-fx-text-fill: #eaeaea;
                          -fx-font-family: 'Courier New';
                          -fx-font-size: 9px;
                          -fx-font-weight: bold;
                          -fx-opacity: 0.3;"/>
            <ListView fx:id="matchupListView"
                      prefHeight="280"
                      style="-fx-background-color: transparent;
                             -fx-border-color: #e94560;
                             -fx-border-width: 1;
                             -fx-border-opacity: 0.25;"/>
            <Label fx:id="statusLabel" text=""
                   style="-fx-text-fill: #f59e0b;
                          -fx-font-family: 'Courier New';
                          -fx-font-size: 11px;
                          -fx-font-weight: bold;"/>
        </VBox>
    </center>

    <!-- ═══ BOTTOM: Button ═══ -->
    <bottom>
        <HBox alignment="CENTER" spacing="20"
              style="-fx-padding: 24 0 36 0;">
            <Button text="Haftayı İlerlet  →" onAction="#onAdvancePlayoff"
                    prefWidth="240" prefHeight="50"
                    style="-fx-background-color: #e94560;
                           -fx-text-fill: #ffffff;
                           -fx-font-family: 'Courier New';
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 0;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, #e94560, 18, 0.35, 0, 4);"/>
            <Button text="Ana Menü" onAction="#onMainMenu"
                    prefWidth="140" prefHeight="50"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #eaeaea;
                           -fx-font-family: 'Courier New';
                           -fx-font-size: 12px;
                           -fx-background-radius: 0;
                           -fx-cursor: hand;
                           -fx-border-color: #0f3460;
                           -fx-border-width: 1;"/>
        </HBox>
    </bottom>

</BorderPane>
