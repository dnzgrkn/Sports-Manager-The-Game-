<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sportsmanager.ui.controller.SeasonEndController"
           prefWidth="1100" prefHeight="700"
           style="-fx-background-color: #0d0d1a;">

    <stylesheets>
        <URL value="@../css/theme.css"/>
        <URL value="@../css/seasonend.css"/>
    </stylesheets>

    <!-- ═══ CENTERED CONTENT VBox ═══════════════════════ -->
    <VBox alignment="CENTER" spacing="0" maxWidth="700">

        <!-- Title block -->
        <VBox alignment="CENTER" spacing="6"
              style="-fx-padding: 0 0 36 0;">
            <Label text="SEZON SONU!"
                   style="-fx-text-fill: #ffffff;
                          -fx-font-family: 'Impact';
                          -fx-font-size: 62px;
                          -fx-effect: dropshadow(gaussian, #e94560, 36, 0.45, 0, 0);"/>
            <!-- Decorative rule -->
            <HBox alignment="CENTER" spacing="0">
                <Region prefHeight="1" prefWidth="140"
                        style="-fx-background-color: #e94560; -fx-opacity: 0.35;"/>
                <Label text="  ─ ● ─  "
                       style="-fx-text-fill: #e94560;
                              -fx-font-family: 'Courier New';
                              -fx-font-size: 10px;
                              -fx-opacity: 0.55;"/>
                <Region prefHeight="1" prefWidth="140"
                        style="-fx-background-color: #e94560; -fx-opacity: 0.35;"/>
            </HBox>
        </VBox>

        <!-- Champion card -->
        <VBox fx:id="championCard" alignment="CENTER" spacing="10"
              style="-fx-background-color: #16213e;
                     -fx-border-color: #f59e0b;
                     -fx-border-width: 1;
                     -fx-padding: 28 72 28 72;
                     -fx-effect: dropshadow(gaussian, #f59e0b, 28, 0.28, 0, 0);">
            <Label text="S E Z O N  Ş A M P İ Y O N U"
                   style="-fx-text-fill: #f59e0b;
                          -fx-font-family: 'Courier New';
                          -fx-font-size: 10px;
                          -fx-font-weight: bold;
                          -fx-opacity: 0.5;"/>
            <Label fx:id="championLabel" text=""
                   style="-fx-text-fill: #f59e0b;
                          -fx-font-family: 'Impact';
                          -fx-font-size: 36px;
                          -fx-effect: dropshadow(gaussian, #f59e0b, 16, 0.35, 0, 0);"/>
            <Label fx:id="rankLabel" text=""
                   style="-fx-text-fill: #eaeaea;
                          -fx-font-family: 'Courier New';
                          -fx-font-size: 14px;
                          -fx-opacity: 0.55;"/>
        </VBox>

        <Region prefHeight="32"/>

        <!-- Table section -->
        <VBox spacing="10">
            <Label text="SON PUAN TABLOSU — İLK 5"
                   style="-fx-text-fill: #eaeaea;
                          -fx-font-family: 'Courier New';
                          -fx-font-size: 10px;
                          -fx-font-weight: bold;
                          -fx-opacity: 0.32;"/>
            <TableView fx:id="standingsTable" prefHeight="215" maxHeight="215">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="rankColumn"     text="#"     prefWidth="52"/>
                    <TableColumn fx:id="teamColumn"     text="TAKIM" prefWidth="230"/>
                    <TableColumn fx:id="winsColumn"     text="G"     prefWidth="62"/>
                    <TableColumn fx:id="drawsColumn"    text="B"     prefWidth="62"/>
                    <TableColumn fx:id="lossesColumn"   text="M"     prefWidth="62"/>
                    <TableColumn fx:id="goalDiffColumn" text="AV"    prefWidth="68"/>
                    <TableColumn fx:id="pointsColumn"   text="PTS"   prefWidth="74"/>
                </columns>
            </TableView>
        </VBox>

        <Region prefHeight="38"/>

        <!-- Buttons -->
        <HBox spacing="20" alignment="CENTER">
            <Button text="YENİ SEZONA DEVAM ET" onAction="#onNewSeason"
                    prefWidth="250" prefHeight="52"
                    style="-fx-background-color: #e94560;
                           -fx-text-fill: #ffffff;
                           -fx-font-family: 'Courier New';
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 0;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, #e94560, 18, 0.38, 0, 4);"/>
            <Button text="ANA MENÜYE DÖN" onAction="#onMainMenu"
                    prefWidth="200" prefHeight="52"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #eaeaea;
                           -fx-font-family: 'Courier New';
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 0;
                           -fx-cursor: hand;
                           -fx-border-color: #0f3460;
                           -fx-border-width: 1;"/>
        </HBox>

    </VBox>

</StackPane>
